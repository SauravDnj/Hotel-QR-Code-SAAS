# Copy to .env.local for local development. NEVER commit real values.
# Reference: hotel-saas-documentation/08-deployment/ENVIRONMENT_VARIABLES.md

# Neon pooled connection string (runtime). Neon dashboard -> Connection Details -> "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Neon direct (non-pooled) connection string, used only for migrations and scripts.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Session signing secret, min 32 chars. Generate with: pnpm dlx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Canonical app URL.
APP_URL=http://localhost:3000

# Only needed when NOT running on Vercel (Vercel sets trusted host automatically).
AUTH_TRUST_HOST=true

# Used only by `pnpm platform:admin` when creating a NEW platform operator.
# PLATFORM_ADMIN_PASSWORD=

# Phase 3 (QR + guest portal). Generate each with: openssl rand -base64 32
# Changing QR_TOKEN_PEPPER invalidates every printed QR; changing ENCRYPTION_KEY makes stored
# Wi-Fi passwords and QR tokens unreadable. Keep them stable and backed up.
QR_TOKEN_PEPPER=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Optional: domain printed in QR codes (defaults to APP_URL).
# GUEST_PORTAL_URL=https://guest.example.com

# Phase 4 (optional). Ably API key with publish + subscribe + token capabilities: appId.keyId:secret
# Without it the staff inbox refreshes by polling every 10 seconds.
# ABLY_API_KEY=
# Secret for /api/cron/outbox (Authorization: Bearer <secret>).
# CRON_SECRET=

# Phase 7 (optional): Razorpay TEST keys until launch. Without them the Billing page shows plans but
# online payment is off. Webhook URL: https://<your-domain>/api/webhooks/razorpay
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
